{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tritrack.dev/schemas/transcription-report-v1.schema.json",
  "title": "TriTrack path-free transcription report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "requestedTakeIds", "runSettings", "takes"],
  "properties": {
    "schemaVersion": {"const": "tritrack.transcription-report/v1"},
    "profileId": {"const": "whisper-cpp-cpu-no-fallback-v1"},
    "requestedTakeIds": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/takeId"},
      "uniqueItems": true
    },
    "runSettings": {"$ref": "#/$defs/newSettings"},
    "takes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/take"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "takeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\\\r\\n]+$"
    },
    "modelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "newSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "recognitionModelSha256", "voiceActivity", "voiceActivityModel"],
      "properties": {
        "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
        "recognitionModelSha256": {"$ref": "#/$defs/sha256"},
        "voiceActivity": {"enum": ["off", "on"]},
        "voiceActivityModel": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/modelName"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"voiceActivity": {"const": "off"}}},
          "then": {"properties": {"voiceActivityModel": {"type": "null"}}}
        },
        {
          "if": {"properties": {"voiceActivity": {"const": "on"}}},
          "then": {"properties": {"voiceActivityModel": {"$ref": "#/$defs/modelName"}}}
        }
      ]
    },
    "attemptSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "recognitionModelSha256", "voiceActivity", "voiceActivityModel"],
      "properties": {
        "language": {"oneOf": [{"const": "unknown"}, {"type": "string", "pattern": "^[a-z]{2,3}$"}]},
        "recognitionModelSha256": {"oneOf": [{"const": "unknown"}, {"$ref": "#/$defs/sha256"}]},
        "voiceActivity": {"enum": ["off", "on", "unknown"]},
        "voiceActivityModel": {
          "oneOf": [
            {"type": "null"},
            {"const": "unknown"},
            {"$ref": "#/$defs/modelName"}
          ]
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "sourceSha256", "outcome", "failureCode", "settings"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "sourceSha256": {"$ref": "#/$defs/sha256"},
        "outcome": {"enum": ["completed", "empty", "invalid", "failed", "reused"]},
        "failureCode": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^TRITRACK_[A-Z0-9_]+$"}
          ]
        },
        "settings": {"$ref": "#/$defs/attemptSettings"}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"enum": ["completed", "empty", "reused"]}}},
          "then": {"properties": {"failureCode": {"type": "null"}}}
        },
        {
          "if": {"properties": {"outcome": {"enum": ["invalid", "failed"]}}},
          "then": {"properties": {"failureCode": {"type": "string"}}}
        }
      ]
    },
    "take": {
      "type": "object",
      "additionalProperties": false,
      "required": ["takeId", "status", "selectedSourceSha256", "attempts"],
      "properties": {
        "takeId": {"$ref": "#/$defs/takeId"},
        "status": {"enum": ["completed", "empty", "failed", "reused"]},
        "selectedSourceSha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/attempt"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "failed"}}},
          "then": {"properties": {"selectedSourceSha256": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["completed", "empty", "reused"]}}},
          "then": {"properties": {"selectedSourceSha256": {"$ref": "#/$defs/sha256"}}}
        }
      ]
    }
  }
}

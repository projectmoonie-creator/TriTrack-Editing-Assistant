{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tritrack.dev/schemas/transcription-result-manifest-v1.schema.json",
  "title": "TriTrack transcription result manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundle", "report"],
  "properties": {
    "schemaVersion": {"const": "tritrack.transcription-result-manifest/v1"},
    "bundle": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"fileName": {"const": "transcript-bundle.json"}}}
      ]
    },
    "report": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"fileName": {"const": "transcription-report.json"}}}
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
